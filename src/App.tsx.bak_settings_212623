function SettingsView({ pane }: { pane: SettingsPane }) {
  switch (pane) {
    case 'user':
      return <SettingsUser />
    case 'api':
      return <SettingsApi />
    case 'download':
      return <SettingsDownload />
    case 'image':
      return <SettingsImage />
    case 'advanced':
      return <SettingsAdvanced />
    case 'version':
      return <SettingsVersion />
