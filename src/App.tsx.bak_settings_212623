                  type="button"
                  className={`side-item ${settingsPane === s.id ? 'active' : ''}`}
                  onClick={() => setSettingsPane(s.id)}
                >
                  <span className="side-ico">{s.icon}</span>
                  {s.label}
                </button>
              ))}
            </aside>
            <div className="settings-main">
