function statusLabel(s: JobStatus) {
  switch (s) {
    case 'cho':
      return { text: 'Chờ', cls: '' }
    case 'dang_chay':
      return { text: 'Đang chạy', cls: 'run' }
    case 'xong':
      return { text: 'Xong', cls: 'done' }
    case 'loi':
      return { text: 'Lỗi', cls: 'err' }
  }
}

function Toggle({
  on,
  onChange,
}: {
  on: boolean
  onChange: (v: boolean) => void
}) {
  return (
    <button
      type="button"
      className={`toggle ${on ? 'on' : ''}`}
      aria-pressed={on}
      onClick={() => onChange(!on)}
    >
      <span className="toggle-knob" />
    </button>
  )
}

