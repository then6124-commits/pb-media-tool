import { useEffect, useMemo, useRef, useState } from 'react'

type MuseMode = 't2v' | 'i2v' | 't2i'
type Aspect = '16:9' | '9:16'
type RowStatus = 'cho' | 'dang_chay' | 'xong' | 'loi'
type QueueTab = 'all' | 'done' | 'error'
type LogLevel = 'INFO' | 'DEBUG' | 'LỖI' | 'OK' | 'WARN'

type Project = {
  id: number
  name: string
  savePath: string
  parallel: number
}

type RefImage = { id: number; name: string; tag: string }

type QueueRow = {
  id: number
  prompt: string
  mode: MuseMode
  aspect: Aspect
  time: string
  duration: string
  size: string
  status: RowStatus
  error?: string
}

type LogLine = {
  id: number
  time: string
  level: LogLevel
  tag: string
  msg: string
}

const LS_PROJECTS = 'pb.muse.projects'
const LS_ACTIVE = 'pb.muse.active'
const LS_ROWS = 'pb.muse.rows'
const LS_PROMPT = 'pb.muse.prompt'
const LS_ASPECT = 'pb.muse.aspect'
const LS_PARALLEL = 'pb.muse.parallel'
const LS_PATH = 'pb.muse.path'
const LS_MODE = 'pb.muse.mode'
const LS_COOKIE = 'pb.muse.cookie'
const LS_COLLAPSED = 'pb.muse.promptCollapsed'

const DEMO_PROMPTS = [
  'Cinematic wide shot of a honey badger walking through dry savanna grass at golden hour, dust particles in warm light.',
  'Close-up of a leopard resting on a low branch, soft rim light, film grain, shallow depth of field.',
  'Aerial tracking over rocky hills at dusk, documentary wildlife style, natural color grade.',
  'Night scene with lanterns reflecting on wet stone, slow dolly, reverent mood.',
  'Medium shot of two animals facing each other on open plains, gentle camera push-in.',
]

const VM_ERR =
  'Lượt chạy không tới được VM muse.ai (không thấy xác nhận). Thử lại sau.'

function nowTime() {
  const d = new Date()
  return d.toLocaleTimeString('vi-VN', { hour12: false })
}

function modeLabel(m: MuseMode, aspect: Aspect) {
  const base =
    m === 't2v' ? 'Text → Video' : m === 'i2v' ? 'Ảnh → Video' : 'Text → Ảnh'
  return `${base} ${aspect}`
}

function loadJson<T>(key: string, fallback: T): T {
  try {
    const raw = localStorage.getItem(key)
    if (raw) return JSON.parse(raw) as T
  } catch {
    /* ignore */
  }
  return fallback
}

function defaultProjects(): Project[] {
  return [
    {
      id: 1,
      name: 'aa',
      savePath: 'Downloads/New folder (26)',
      parallel: 5,
    },
  ]
}

function defaultRows(): QueueRow[] {
  return DEMO_PROMPTS.map((p, i) => {
    const isErr = i === 3
    return {
      id: i + 1,
      prompt: p,
      mode: 't2v' as MuseMode,
      aspect: '16:9' as Aspect,
      time: `10:${50 + i}:1${i}`,
      duration: isErr ? '—' : `${1 + (i % 3)}m${20 + i * 7}s`,
      size: isErr ? '—' : `${(3.2 + i * 0.4).toFixed(1)} MB`,
      status: (isErr ? 'loi' : 'xong') as RowStatus,
      error: isErr ? VM_ERR : undefined,
    }
  })
}

function seedLogs(): LogLine[] {
  const lines: Array<Omit<LogLine, 'id'>> = [
    { time: '10:55:01', level: 'INFO', tag: 'runner', msg: 'Mở dự án aa — chế độ Text → Video.' },
    { time: '10:55:10', level: 'INFO', tag: 'runner', msg: 'Gửi job text-to-video: 01…' },
    { time: '10:56:53', level: 'OK', tag: 'download', msg: 'Đã tải 01_aa-char-01…mp4 (4.7 MB).' },
    { time: '10:57:02', level: 'INFO', tag: 'runner', msg: 'Gửi job text-to-video: 02…' },
    { time: '10:58:40', level: 'OK', tag: 'download', msg: 'Đã tải 02_aa-char-02…mp4 (5.1 MB).' },
    { time: '10:59:01', level: 'INFO', tag: 'runner', msg: 'Gửi job text-to-video: 03…' },
    { time: '11:00:12', level: 'OK', tag: 'download', msg: 'Đã tải 03_aa-char-03…mp4 (4.9 MB).' },
    { time: '11:00:30', level: 'INFO', tag: 'runner', msg: 'Gửi job text-to-video: 04…' },
    {
      time: '11:01:05',
      level: 'LỖI',
      tag: 'runner',
      msg: 'Lượt chạy không tới được VM muse.ai (không thấy xác nhận).',
    },
    { time: '11:01:20', level: 'INFO', tag: 'runner', msg: 'Gửi job text-to-video: 05…' },
    { time: '11:03:01', level: 'OK', tag: 'download', msg: 'Đã tải 05_aa-char-05…mp4 (5.4 MB).' },
    { time: '11:04:00', level: 'DEBUG', tag: 'cookie', msg: 'Cookie muse.ai: mock localStorage — không đọc cookie thật.' },
    { time: '11:05:12', level: 'INFO', tag: 'runner', msg: 'Người dùng mở nhật ký hoạt động.' },
    { time: '11:06:00', level: 'WARN', tag: 'i2v', msg: 'Ảnh → Video cần ít nhất 1 ảnh tham chiếu.' },
  ]
  return lines.map((l, i) => ({ ...l, id: i + 1 }))
}

const PROMPT_PLACEHOLDER =
  'Mỗi dòng là một prompt riêng (chạy lần lượt). Ví dụ: Một con rồng bay qua thành phố lúc hoàng hôn, góc rộng.'

export default function MuseWorkspace() {
  const [projects, setProjects] = useState<Project[]>(() =>
    loadJson(LS_PROJECTS, defaultProjects()),
  )
  const [activeId, setActiveId] = useState<number>(() => {
    const v = loadJson<number | null>(LS_ACTIVE, null)
    return v ?? defaultProjects()[0].id
  })
  const [rows, setRows] = useState<QueueRow[]>(() => loadJson(LS_ROWS, defaultRows()))
  const [promptText, setPromptText] = useState(() => {
    try {
      return localStorage.getItem(LS_PROMPT) || ''
    } catch {
      return ''
    }
  })
  const [aspect, setAspect] = useState<Aspect>(() => loadJson(LS_ASPECT, '16:9'))
  const [parallel, setParallel] = useState(() => loadJson(LS_PARALLEL, 5))
  const [mode, setMode] = useState<MuseMode>(() => loadJson(LS_MODE, 't2v'))
  const [savePath, setSavePath] = useState(() => {
    try {
      return localStorage.getItem(LS_PATH) || 'Downloads/New folder (26)'
    } catch {
      return 'Downloads/New folder (26)'
    }
  })
  const [cookie, setCookie] = useState(() => {
    try {
      return localStorage.getItem(LS_COOKIE) || ''
    } catch {
      return ''
    }
  })
  const [refs, setRefs] = useState<RefImage[]>([])
  const [queueTab, setQueueTab] = useState<QueueTab>('all')
  const [search, setSearch] = useState('')
  const [collapsed, setCollapsed] = useState(() => loadJson(LS_COLLAPSED, false))
  const [sideCollapsed, setSideCollapsed] = useState(false)
  const [showCreate, setShowCreate] = useState(false)
  const [newName, setNewName] = useState('')
  const [showCookie, setShowCookie] = useState(false)
  const [cookieDraft, setCookieDraft] = useState('')
  const [cookieStatus, setCookieStatus] = useState<string | null>(null)
  const [showLog, setShowLog] = useState(false)
  const [logs, setLogs] = useState<LogLine[]>(() => seedLogs())
  const [toast, setToast] = useState<string | null>(null)
  const [selected, setSelected] = useState<number[]>([])
  const fileRef = useRef<HTMLInputElement>(null)
  const imgRef = useRef<HTMLInputElement>(null)
  const nextId = useRef(100)

  const active = projects.find((p) => p.id === activeId) || projects[0]

  useEffect(() => {
    try {
      localStorage.setItem(LS_PROJECTS, JSON.stringify(projects))
      localStorage.setItem(LS_ACTIVE, JSON.stringify(activeId))
      localStorage.setItem(LS_ROWS, JSON.stringify(rows))
      localStorage.setItem(LS_PROMPT, promptText)
      localStorage.setItem(LS_ASPECT, JSON.stringify(aspect))
      localStorage.setItem(LS_PARALLEL, JSON.stringify(parallel))
      localStorage.setItem(LS_PATH, savePath)
      localStorage.setItem(LS_MODE, JSON.stringify(mode))
      localStorage.setItem(LS_COOKIE, cookie)
      localStorage.setItem(LS_COLLAPSED, JSON.stringify(collapsed))
    } catch {
      /* ignore */
    }
  }, [
    projects,
    activeId,
    rows,
    promptText,
    aspect,
    parallel,
    savePath,
    mode,
    cookie,
    collapsed,
  ])

  useEffect(() => {
    if (!toast) return
    const t = setTimeout(() => setToast(null), 2200)
    return () => clearTimeout(t)
  }, [toast])

  const flash = (msg: string) => setToast(msg)

  const pushLog = (level: LogLevel, tag: string, msg: string) => {
    setLogs((prev) => {
      const line: LogLine = {
        id: Date.now() + Math.random(),
        time: nowTime(),
        level,
        tag,
        msg,
      }
      return [line, ...prev].slice(0, 120)
    })
  }

  const counts = useMemo(() => {
    const done = rows.filter((r) => r.status === 'xong').length
    const err = rows.filter((r) => r.status === 'loi').length
    return { all: rows.length, done, err }
  }, [rows])

  const logErrCount = useMemo(
    () => logs.filter((l) => l.level === 'LỖI').length,
    [logs],
  )

  const filteredRows = useMemo(() => {
    let list = rows
    if (queueTab === 'done') list = list.filter((r) => r.status === 'xong')
    if (queueTab === 'error') list = list.filter((r) => r.status === 'loi')
    const q = search.trim().toLowerCase()
    if (q) list = list.filter((r) => r.prompt.toLowerCase().includes(q))
    return list
  }, [rows, queueTab, search])

  const promptCount = useMemo(() => {
    return promptText
      .split('\n')
      .map((l) => l.trim())
      .filter(Boolean).length
  }, [promptText])

  const needRefWarn = mode === 'i2v' && refs.length === 0

  const createProject = () => {
    const name = newName.trim() || `dự án ${projects.length + 1}`
    const id = Date.now()
    const p: Project = {
      id,
      name,
      savePath: savePath || 'Downloads',
      parallel,
    }
    setProjects((prev) => [...prev, p])
    setActiveId(id)
    setShowCreate(false)
    setNewName('')
    pushLog('INFO', 'project', `Đã tạo dự án «${name}».`)
    flash(`Đã tạo dự án ${name}`)
  }

  const pickPath = () => {
    const next = window.prompt('Thư mục lưu (mock — chỉ localStorage)', savePath)
    if (next != null && next.trim()) {
      setSavePath(next.trim())
      flash('Đã cập nhật đường dẫn (mock)')
    }
  }

  const loadTxt = (f: File) => {
    const reader = new FileReader()
    reader.onload = () => {
      const text = String(reader.result || '')
      setPromptText(text)
      setCollapsed(false)
      pushLog('INFO', 'prompt', `Nạp TXT: ${f.name}`)
      flash(`Đã nạp ${f.name}`)
    }
    reader.readAsText(f)
  }

  const addRef = (f: File) => {
    if (refs.length >= 8) {
      flash('Tối đa 8 ảnh tham chiếu')
      return
    }
    const base = f.name.replace(/\.[^.]+$/, '').slice(0, 24)
    const tag = `@${base || 'ref'}`
    setRefs((prev) => [
      ...prev,
      { id: Date.now() + Math.random(), name: f.name, tag },
    ])
    pushLog('INFO', 'i2v', `Đã thêm ảnh tham chiếu ${f.name} (mock).`)
    flash(`Đã thêm ${tag}`)
  }

  const runPrompts = () => {
    const lines = promptText
      .split('\n')
      .map((l) => l.trim())
      .filter(Boolean)
    if (!lines.length) {
      flash('Chưa có prompt')
      return
    }
    if (mode === 'i2v' && refs.length === 0) {
      flash('Cần ít nhất 1 ảnh tham chiếu')
      pushLog('WARN', 'i2v', 'Ảnh → Video cần ít nhất 1 ảnh tham chiếu.')
      return
    }
    const newRows: QueueRow[] = lines.map((p) => ({
      id: nextId.current++,
      prompt: p,
      mode,
      aspect,
      time: nowTime(),
      duration: '—',
      size: '—',
      status: 'loi' as RowStatus,
      error: cookie.trim()
        ? VM_ERR
        : 'Chưa cấu hình Cookie muse.ai — dán cookie mock rồi Kiểm tra kết nối.',
    }))
    setRows((prev) => [...newRows, ...prev])
    pushLog(
      'INFO',
      'runner',
      `Bắt đầu loạt: ${lines.length} prompt · ${modeLabel(mode, aspect)} · ${parallel} song song (mock).`,
    )
    pushLog(
      'LỖI',
      'runner',
      cookie.trim()
        ? VM_ERR
        : 'Cookie muse.ai chưa có — mở nút Cookie muse.ai để dán mock.',
    )
    setShowLog(true)
    flash(`Đã thêm ${lines.length} job (mock)`)
  }

  const retryErrors = () => {
    const n = rows.filter((r) => r.status === 'loi').length
    if (!n) {
      flash('Không có lỗi để tạo lại')
      return
    }
    setRows((prev) =>
      prev.map((r) =>
        r.status === 'loi' ? { ...r, status: 'loi', error: VM_ERR, time: nowTime() } : r,
      ),
    )
    pushLog('INFO', 'runner', `Tạo lại lỗi: ${n} job.`)
    pushLog('LỖI', 'runner', VM_ERR)
    setShowLog(true)
    flash(`Đã tạo lại ${n} lỗi (mock)`)
  }

  const retryPending = () => {
    const n = rows.filter((r) => r.status !== 'xong').length
    setRows((prev) =>
      prev.map((r) =>
        r.status !== 'xong'
          ? { ...r, status: 'loi', error: VM_ERR, time: nowTime() }
          : r,
      ),
    )
    pushLog('INFO', 'runner', `Tạo lại chưa xong: ${n} job.`)
    flash(`Đã tạo lại ${n} mục (mock)`)
  }

  const downloadAll = () => {
    pushLog('INFO', 'download', `Tải tất cả ${rows.length} mục (mock — không ghi file).`)
    flash(`Tải tất cả (${rows.length}) — mock`)
  }

  const clearDone = () => {
    const n = rows.filter((r) => r.status === 'xong').length
    setRows((prev) => prev.filter((r) => r.status !== 'xong'))
    pushLog('INFO', 'runner', `Đã xoá ${n} mục đã xong.`)
    flash(`Đã xoá ${n} hoàn thành`)
  }

  const clearAll = () => {
    if (!window.confirm('Xoá toàn bộ hàng đợi?')) return
    const n = rows.length
    setRows([])
    setSelected([])
    pushLog('INFO', 'runner', `Đã xoá toàn bộ (${n}).`)
    flash('Đã xoá toàn bộ')
  }

  const toggleSelect = (id: number) => {
    setSelected((prev) =>
      prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id],
    )
  }

  const selectAllFiltered = () => {
    const ids = filteredRows.map((r) => r.id)
    const allOn = ids.length > 0 && ids.every((id) => selected.includes(id))
    setSelected(
      allOn
        ? selected.filter((id) => !ids.includes(id))
        : [...new Set([...selected, ...ids])],
    )
  }

  const openCookieModal = () => {
    setCookieDraft(cookie)
    setCookieStatus(null)
    setShowCookie(true)
  }

  const checkCookie = () => {
    const v = cookieDraft.trim()
    setCookie(v)
    if (!v) {
      setCookieStatus('Chưa dán cookie mock.')
      pushLog('WARN', 'cookie', 'Kiểm tra kết nối: trống.')
      return
    }
    // Mock only — never read real browser cookies
    setCookieStatus('Kết nối mock OK — đã lưu localStorage (không đọc cookie thật).')
    pushLog(
      'OK',
      'cookie',
      `Kiểm tra kết nối mock OK · ${v.length} ký tự (localStorage).`,
    )
    flash('Cookie muse.ai đã lưu (mock)')
  }

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault()
        runPrompts()
      }
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [promptText, mode, refs, cookie, aspect, parallel])

  return (
    <div className="muse-root">
      {!sideCollapsed && (
        <aside className="muse-side">
          <div className="muse-brand">
            <div>
              <div className="muse-brand-title">Muse</div>
              <div className="muse-brand-sub">muse.ai Studio</div>
            </div>
            <button
              type="button"
              className="muse-icon-btn"
              title="Thu gọn"
              onClick={() => setSideCollapsed(true)}
            >
              ‹
            </button>
          </div>
          <div className="muse-proj-head">
            <span>DỰ ÁN ({projects.length})</span>
            <button
              type="button"
              className="muse-plus"
              title="Tạo dự án"
              onClick={() => setShowCreate(true)}
            >
              +
            </button>
          </div>
          <div className="muse-proj-list">
            {projects.map((p) => (
              <button
                key={p.id}
                type="button"
                className={`muse-proj ${p.id === activeId ? 'on' : ''}`}
                onClick={() => setActiveId(p.id)}
              >
                <span className="muse-proj-ico">✦</span>
                <span className="muse-proj-name">{p.name}</span>
              </button>
            ))}
          </div>
        </aside>
      )}

      <div className="muse-main">
        <div className="muse-topbar">
          {sideCollapsed && (
            <button
              type="button"
              className="muse-icon-btn"
              onClick={() => setSideCollapsed(false)}
              title="Mở sidebar"
            >
              ›
            </button>
          )}
          <div className="muse-proj-title">
            <span className="muse-proj-ico">✦</span>
            <strong>{active?.name || '—'}</strong>
          </div>
          <div className="muse-save">
            <span className="muse-muted">Lưu vào</span>
            <input
              className="muse-path"
              value={savePath}
              onChange={(e) => setSavePath(e.target.value)}
            />
            <button
              type="button"
              className="muse-icon-btn sm"
              onClick={pickPath}
              title="Chọn thư mục"
            >
              📁
            </button>
          </div>
          <button type="button" className="muse-cookie-btn" onClick={openCookieModal}>
            <span className={`muse-plug ${cookie.trim() ? 'on' : ''}`}>🔌</span>
            Cookie muse.ai
          </button>
          <div className="muse-progress">
            <span className="muse-progress-ring" />
            {counts.done}/{counts.all} hoàn thành
          </div>
          <button
            type="button"
            className="muse-bell"
            title="Nhật ký hoạt động"
            onClick={() => setShowLog(true)}
          >
            🔔
            {logErrCount > 0 && (
              <span className="muse-bell-badge">{logErrCount}</span>
            )}
          </button>
        </div>

        {!collapsed && (
          <section className="muse-prompt-card">
            <div className="muse-prompt-head">
              <div className="muse-modes">
                <button
                  type="button"
                  className={mode === 't2v' ? 'on' : ''}
                  onClick={() => setMode('t2v')}
                >
                  Text → Video
                </button>
                <button
                  type="button"
                  className={mode === 'i2v' ? 'on' : ''}
                  onClick={() => setMode('i2v')}
                >
                  Ảnh → Video
                </button>
                <button
                  type="button"
                  className={mode === 't2i' ? 'on' : ''}
                  onClick={() => setMode('t2i')}
                >
                  Text → Ảnh
                </button>
              </div>
              <div className="muse-prompt-actions">
                <button
                  type="button"
                  className="muse-ghost"
                  onClick={() => fileRef.current?.click()}
                >
                  Nạp TXT
                </button>
                <span className="muse-ghost muted">{promptCount} job</span>
                <button
                  type="button"
                  className="muse-ghost"
                  onClick={() => setCollapsed(true)}
                >
                  Thu gọn ▴
                </button>
              </div>
            </div>

            <textarea
              className="muse-textarea"
              value={promptText}
              onChange={(e) => setPromptText(e.target.value)}
              placeholder={PROMPT_PLACEHOLDER}
              rows={6}
            />

            {mode === 'i2v' && (
              <>
                <div className="muse-ref-row">
                  <button
                    type="button"
                    className="muse-ref-btn"
                    onClick={() => imgRef.current?.click()}
                  >
                    + Tải ảnh tham chiếu
                  </button>
                  <span className="muse-muted">
                    Hoặc dán clipboard (Ctrl/Cmd+V). PNG, JPG, WEBP, GIF — tối đa 10MB · tối
                    đa 8 ảnh.
                  </span>
                </div>
                {refs.length > 0 && (
                  <div className="muse-ref-list">
                    {refs.map((r) => (
                      <span key={r.id} className="muse-ref-tag">
                        {r.tag}
                        <button
                          type="button"
                          onClick={() =>
                            setRefs((prev) => prev.filter((x) => x.id !== r.id))
                          }
                        >
                          ×
                        </button>
                      </span>
                    ))}
                  </div>
                )}
              </>
            )}

            <div className="muse-run-row">
              <div className="muse-aspect">
                <button
                  type="button"
                  className={aspect === '16:9' ? 'on' : ''}
                  onClick={() => setAspect('16:9')}
                >
                  16:9 Ngang
                </button>
                <button
                  type="button"
                  className={aspect === '9:16' ? 'on' : ''}
                  onClick={() => setAspect('9:16')}
                >
                  9:16 Dọc
                </button>
              </div>
              <div className="muse-parallel-mini">
                <span>⟳</span>
                <select
                  value={parallel}
                  onChange={(e) => setParallel(Number(e.target.value))}
                >
                  {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => (
                    <option key={n} value={n}>
                      {n}
                    </option>
                  ))}
                </select>
              </div>
              {needRefWarn ? (
                <span className="muse-warn-pill">Cần ít nhất 1 ảnh tham chiếu</span>
              ) : (
                <span className="muse-muted sm-help">
                  {mode === 't2v'
                    ? 'Mô tả cảnh, muse.ai dựng video — mỗi dòng là một job riêng.'
                    : mode === 't2i'
                      ? 'Mỗi dòng = 1 ảnh. muse.ai render lần lượt.'
                      : 'Ảnh tham chiếu + prompt → video.'}
                </span>
              )}
              <button
                type="button"
                className="muse-run"
                onClick={runPrompts}
                disabled={!promptCount || needRefWarn}
              >
                ▶ Chạy prompt (Ctrl+↵)
              </button>
            </div>
          </section>
        )}

        {collapsed && (
          <button
            type="button"
            className="muse-expand-prompt"
            onClick={() => setCollapsed(false)}
          >
            Mở khung prompt ▾ · {promptCount} job · {modeLabel(mode, aspect)}
          </button>
        )}

        <section className="muse-queue">
          <div className="muse-queue-head">
            <div className="muse-tabs">
              <button
                type="button"
                className={queueTab === 'all' ? 'on' : ''}
                onClick={() => setQueueTab('all')}
              >
                Tất cả ({counts.all})
              </button>
              <button
                type="button"
                className={queueTab === 'done' ? 'on' : ''}
                onClick={() => setQueueTab('done')}
              >
                Hoàn thành ({counts.done})
              </button>
              <button
                type="button"
                className={`err ${queueTab === 'error' ? 'on' : ''}`}
                onClick={() => setQueueTab('error')}
              >
                Lỗi ({counts.err})
              </button>
            </div>
            <div className="muse-queue-tools">
              <input
                className="muse-search"
                placeholder="Tìm prompt..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
              />
              <button type="button" className="muse-ghost" onClick={selectAllFiltered}>
                STT
              </button>
              <button type="button" className="muse-link ok" onClick={downloadAll}>
                Tải tất cả ({counts.all})
              </button>
              <button type="button" className="muse-link warn" onClick={retryErrors}>
                Tạo lại lỗi ({counts.err})
              </button>
              <button type="button" className="muse-link info" onClick={retryPending}>
                Tạo lại tất cả chưa tạo ({counts.all - counts.done})
              </button>
              <button type="button" className="muse-link" onClick={clearDone}>
                Xoá đã xong
              </button>
              <button type="button" className="muse-link danger" onClick={clearAll}>
                Xoá toàn bộ
              </button>
            </div>
          </div>

          <div className="muse-table-wrap">
            <table className="muse-table">
              <thead>
                <tr>
                  <th style={{ width: 36 }}>
                    <input
                      type="checkbox"
                      checked={
                        filteredRows.length > 0 &&
                        filteredRows.every((r) => selected.includes(r.id))
                      }
                      onChange={selectAllFiltered}
                    />
                  </th>
                  <th style={{ width: 44 }}>#</th>
                  <th style={{ width: 72 }}>MEDIA</th>
                  <th>PROMPT</th>
                  <th style={{ width: 130 }}>CHẾ ĐỘ</th>
                  <th style={{ width: 110 }}>THỜI GIAN</th>
                  <th style={{ width: 110 }}>TRẠNG THÁI</th>
                  <th style={{ width: 120 }}>THAO TÁC</th>
                </tr>
              </thead>
              <tbody>
                {filteredRows.length === 0 && (
                  <tr>
                    <td colSpan={8} className="muse-empty">
                      Chưa có mục trong hàng đợi
                    </td>
                  </tr>
                )}
                {filteredRows.map((r, idx) => (
                  <tr key={r.id} className={r.status === 'loi' ? 'is-err' : ''}>
                    <td>
                      <input
                        type="checkbox"
                        checked={selected.includes(r.id)}
                        onChange={() => toggleSelect(r.id)}
                      />
                    </td>
                    <td className="muse-num">{String(idx + 1).padStart(2, '0')}</td>
                    <td className="muse-media">
                      {r.status === 'loi' ? (
                        <span className="muse-warn-tri" title="Lỗi">
                          ⚠
                        </span>
                      ) : r.status === 'xong' ? (
                        <span className="muse-media-ok">▶</span>
                      ) : (
                        <span className="muse-media-wait">…</span>
                      )}
                    </td>
                    <td className="muse-prompt-cell">
                      <div className="muse-prompt-text">{r.prompt}</div>
                      {r.status === 'loi' && r.error && (
                        <div className="muse-err-box">
                          <div>{r.error}</div>
                          <button
                            type="button"
                            className="muse-cookie-link"
                            onClick={openCookieModal}
                          >
                            Mở Cookie muse.ai
                          </button>
                        </div>
                      )}
                    </td>
                    <td>
                      <span className="muse-type">{modeLabel(r.mode, r.aspect)}</span>
                    </td>
                    <td>
                      <div className="muse-time">{r.time}</div>
                      <div className="muse-muted tiny">
                        {r.duration}
                        {r.size !== '—' ? ` · ${r.size}` : ''}
                      </div>
                    </td>
                    <td>
                      <span className={`muse-status ${r.status}`}>
                        {r.status === 'loi'
                          ? 'Lỗi'
                          : r.status === 'xong'
                            ? 'Hoàn thành'
                            : r.status === 'dang_chay'
                              ? 'Đang chạy'
                              : 'Chờ'}
                      </span>
                    </td>
                    <td className="muse-ops">
                      <button
                        type="button"
                        title="Tải"
                        onClick={() => {
                          pushLog('INFO', 'download', `Tải #${r.id} (mock).`)
                          flash('Tải mock')
                        }}
                      >
                        ⬇
                      </button>
                      <button
                        type="button"
                        title="Chạy lại"
                        onClick={() => {
                          pushLog('INFO', 'runner', `Thử lại #${r.id}`)
                          pushLog('LỖI', 'runner', VM_ERR)
                          setRows((prev) =>
                            prev.map((x) =>
                              x.id === r.id
                                ? { ...x, status: 'loi', error: VM_ERR, time: nowTime() }
                                : x,
                            ),
                          )
                          setShowLog(true)
                        }}
                      >
                        ↻
                      </button>
                      <button
                        type="button"
                        title="Chép prompt"
                        onClick={() => {
                          navigator.clipboard?.writeText(r.prompt).catch(() => {})
                          flash('Đã chép prompt')
                        }}
                      >
                        📋
                      </button>
                      <button
                        type="button"
                        title="Sửa"
                        onClick={() => {
                          setPromptText(r.prompt)
                          setMode(r.mode)
                          setAspect(r.aspect)
                          setCollapsed(false)
                          flash('Đã đưa prompt lên khung nhập')
                        }}
                      >
                        ✎
                      </button>
                      <button
                        type="button"
                        title="Xoá"
                        onClick={() => {
                          setRows((prev) => prev.filter((x) => x.id !== r.id))
                          pushLog('INFO', 'runner', `Đã xoá dòng #${r.id}`)
                        }}
                      >
                        🗑
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>

      {showLog && (
        <aside className="muse-log">
          <div className="muse-log-head">
            <div>
              <strong>NHẬT KÝ HOẠT ĐỘNG</strong>
              <span className="muse-muted">
                {' '}
                — {logs.length} dòng · {logErrCount} lỗi (mất khi đóng app)
              </span>
            </div>
            <div className="muse-log-actions">
              <button
                type="button"
                className="muse-ghost"
                onClick={() => {
                  setLogs([])
                  flash('Đã xoá nhật ký')
                }}
              >
                Xoá
              </button>
              <button
                type="button"
                className="muse-icon-btn"
                onClick={() => setShowLog(false)}
              >
                ×
              </button>
            </div>
          </div>
          <div className="muse-log-body">
            {logs.length === 0 && (
              <div className="muse-muted" style={{ padding: 12 }}>
                Chưa có dòng nhật ký
              </div>
            )}
            {logs.map((l) => (
              <div
                key={l.id}
                className={`muse-log-line ${l.level === 'LỖI' ? 'err' : ''} ${l.level === 'OK' ? 'ok' : ''}`}
              >
                <span className="muse-log-time">{l.time}</span>
                <span
                  className={`muse-log-lvl ${l.level === 'LỖI' ? 'err' : ''} ${l.level === 'OK' ? 'ok' : ''}`}
                >
                  {l.level}
                </span>
                <span className="muse-log-tag">[{l.tag}]</span>
                <span className="muse-log-msg">{l.msg}</span>
              </div>
            ))}
          </div>
        </aside>
      )}

      {showCreate && (
        <div className="muse-modal-backdrop" onClick={() => setShowCreate(false)}>
          <div className="muse-modal" onClick={(e) => e.stopPropagation()}>
            <div className="muse-modal-title">
              <span>✦</span> Tạo dự án Muse
            </div>
            <label className="muse-field-label">Tên dự án</label>
            <input
              className="muse-input"
              placeholder="Ví dụ: aa"
              value={newName}
              onChange={(e) => setNewName(e.target.value)}
              autoFocus
              onKeyDown={(e) => {
                if (e.key === 'Enter') createProject()
              }}
            />
            <div className="muse-modal-foot">
              <button
                type="button"
                className="muse-ghost"
                onClick={() => setShowCreate(false)}
              >
                Huỷ
              </button>
              <button type="button" className="muse-run" onClick={createProject}>
                Tạo dự án
              </button>
            </div>
          </div>
        </div>
      )}

      {showCookie && (
        <div className="muse-modal-backdrop" onClick={() => setShowCookie(false)}>
          <div
            className="muse-modal muse-cookie-modal"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="muse-modal-title">
              <span>🔑</span> Cookie muse.ai
              <button
                type="button"
                className="muse-icon-btn"
                style={{ marginLeft: 'auto' }}
                onClick={() => setShowCookie(false)}
              >
                ×
              </button>
            </div>
            <p className="muse-cookie-help">
              Dán chuỗi cookie mock từ muse.ai (Cookie-Editor → Export → Header String). Chỉ
              lưu <strong>localStorage</strong> — UI mock, <strong>không</strong> đọc cookie
              trình duyệt thật.
            </p>
            <label className="muse-field-label">Cookie</label>
            <textarea
              className="muse-cookie-area"
              value={cookieDraft}
              onChange={(e) => setCookieDraft(e.target.value)}
              placeholder="idpr=…; datr=…; …"
              rows={5}
            />
            {cookieStatus && <div className="muse-cookie-status">{cookieStatus}</div>}
            <div className="muse-modal-foot">
              <button
                type="button"
                className="muse-ghost"
                onClick={() => setShowCookie(false)}
              >
                Đóng
              </button>
              <button type="button" className="muse-run" onClick={checkCookie}>
                Kiểm tra kết nối
              </button>
            </div>
          </div>
        </div>
      )}

      <input
        ref={fileRef}
        type="file"
        accept=".txt,.md,.json"
        hidden
        onChange={(e) => {
          const f = e.target.files?.[0]
          if (f) loadTxt(f)
          e.target.value = ''
        }}
      />
      <input
        ref={imgRef}
        type="file"
        accept="image/*"
        hidden
        multiple
        onChange={(e) => {
          const files = e.target.files
          if (files) Array.from(files).forEach(addRef)
          e.target.value = ''
        }}
      />

      {toast && <div className="muse-toast">{toast}</div>}
    </div>
  )
}
