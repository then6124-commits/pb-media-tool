.veo-create-project {
  width: 100%; border: 0; border-radius: 10px; padding: 11px 14px; cursor: pointer;
  background: linear-gradient(180deg, #f87171, #ef4444); color: #fff; font-weight: 750; font-size: 13.5px;
}
.veo-script-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  text-align: center; padding: 28px 12px; color: #8b97ab; font-size: 12.5px; border-radius: 12px;
  border: 1px dashed #2a3344; background: #0c1017; min-height: 140px;
}
.veo-field { display: flex; flex-direction: column; gap: 5px; }
.veo-field label { font-size: 12px; color: #8b97ab; }

.veo-modal-backdrop {
  position: fixed; inset: 0; z-index: 80; background: rgba(0,0,0,0.62);
  display: grid; place-items: center; padding: 18px;
}
.veo-modal {
  width: min(720px, 96vw); max-height: min(88vh, 820px); overflow: hidden;
  display: flex; flex-direction: column; border-radius: 14px; border: 1px solid #2a3344;
  background: #121826; box-shadow: 0 24px 80px rgba(0,0,0,0.55);
}
.veo-modal-head {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 14px 16px 8px; border-bottom: 1px solid #1f2937;
}
.veo-modal-head h3 { margin: 0; font-size: 16px; display: flex; align-items: center; gap: 8px; }
.veo-modal-ico.red { color: #f87171; }
.veo-modal-ico.green { color: #4ade80; }
.veo-modal-ico.amber { color: #fbbf24; }
.veo-modal-x { border: 0; background: transparent; color: #8b97ab; font-size: 16px; cursor: pointer; padding: 4px 8px; }
.veo-modal-tabs {
  display: flex; gap: 4px; padding: 8px 12px; border-bottom: 1px solid #1f2937; overflow-x: auto;
}
.veo-modal-tab {
  border: 0; background: transparent; color: #8b97ab; border-radius: 8px;
  padding: 8px 12px; font-size: 12.5px; font-weight: 650; cursor: pointer; white-space: nowrap;
}
.veo-modal-tab.on.sync { background: rgba(74,222,128,0.14); color: #4ade80; }
.veo-modal-tab.on.youtube { background: rgba(248,113,113,0.14); color: #f87171; }
.veo-modal-tab.on.tiktok { background: rgba(45,212,191,0.14); color: #2dd4bf; }
.veo-modal-tab.on.upload { background: rgba(96,165,250,0.14); color: #60a5fa; }
.veo-modal-tab.on.ideas { background: rgba(251,191,36,0.14); color: #fbbf24; }
.veo-modal-body {
  padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; overflow: auto; flex: 1;
}
.veo-modal-textarea {
  width: 100%; min-height: 90px; resize: vertical; border-radius: 8px; border: 1px solid #2a3344;
  background: #0c1017; color: #e8eef8; padding: 10px 12px; font-size: 13px; font-family: inherit;
}
.veo-modal-textarea.tall { min-height: 120px; }
.veo-sync-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.veo-sync-slot {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  min-height: 96px; border: 1.5px dashed #3a4660; border-radius: 10px; background: #0c1017;
  color: #9aa6ba; cursor: pointer; font-size: 12.5px;
}
.veo-hint { margin: 0; font-size: 12px; color: #8b97ab; line-height: 1.4; }
.veo-style-search {
  display: flex; align-items: center; gap: 8px; border: 1px solid #2a3344; border-radius: 8px;
  background: #0c1017; padding: 6px 10px;
}
.veo-style-search input {
  flex: 1; border: 0; background: transparent; color: #e8eef8; outline: none; font-size: 12.5px;
}
.veo-style-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
}
.veo-style-item {
  position: relative; border: 1px solid #2a3344; background: #1a2130; color: #d5dbe8;
  border-radius: 8px; padding: 10px 8px; font-size: 12px; cursor: pointer; text-align: center;
}
.veo-style-item.on { border-color: #f87171; box-shadow: inset 0 0 0 1px #f87171; color: #fff; }
.veo-style-item .check {
  position: absolute; top: 4px; right: 6px; color: #f87171; font-size: 11px; font-weight: 800;
}
.veo-modal-opts { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.veo-select.sm { width: auto; min-width: 120px; }
.veo-custom-prompt { border-top: 1px solid #1f2937; padding-top: 8px; color: #c9d2e0; font-size: 13px; }
.veo-custom-prompt summary { cursor: pointer; }
.veo-idea-presets { display: flex; gap: 6px; flex-wrap: wrap; }
.veo-idea-custom { display: flex; gap: 12px; align-items: end; flex-wrap: wrap; }
.veo-idea-custom label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: #8b97ab; }
.veo-idea-custom input {
  width: 72px; border: 1px solid #2a3344; background: #0c1017; color: #e8eef8;
  border-radius: 8px; padding: 7px 8px; font-size: 13px;
}
.veo-idea-total { font-size: 12.5px; color: #2dd4bf; font-weight: 700; padding-bottom: 8px; }
.veo-modal-foot {
  display: flex; justify-content: space-between; gap: 10px; padding: 12px 16px 16px;
  border-top: 1px solid #1f2937;
}
.veo-btn-ghost {
  border: 1px solid #2a3344; background: #1a2130; color: #d5dbe8; border-radius: 10px;
  padding: 10px 18px; cursor: pointer; font-weight: 650;
}
.veo-btn-go {
  border: 0; border-radius: 10px; padding: 10px 18px; cursor: pointer; font-weight: 750; color: #fff;
  background: linear-gradient(180deg, #4ade80, #22c55e);
}
.veo-btn-go.youtube, .veo-btn-go.tiktok { background: linear-gradient(180deg, #f87171, #ef4444); }
.veo-btn-go.ideas { background: linear-gradient(180deg, #fbbf24, #f59e0b); color: #1f1400; }
.veo-btn-go.sync { background: linear-gradient(180deg, #4ade80, #22c55e); }


/* ===== Veo3 functional mock extras ===== */
.veo-canvas-meta { flex: 1; display: flex; align-items: center; padding: 0 10px; min-width: 0; }
.veo-job-grid { display: grid; gap: 12px; padding: 12px; width: 100%; align-content: start; overflow: auto; }
.veo-job-grid.list { grid-template-columns: 1fr; }
.veo-job-grid.grid2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.veo-job-grid.grid3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.veo-job-card {
  display: flex; gap: 10px; background: #151b27; border: 1px solid #243044;
  border-radius: 12px; padding: 10px; min-height: 110px;
}
.veo-job-card.dang_chay { border-color: rgba(56, 189, 248, 0.45); }
.veo-job-card.xong { border-color: rgba(74, 222, 128, 0.35); }
.veo-job-card.loi { border-color: rgba(248, 113, 113, 0.45); }
.veo-job-thumb {
  width: 88px; min-width: 88px; border-radius: 10px; background: linear-gradient(145deg, #1e293b, #0f172a);
  display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;
}
.veo-job-play { color: #7dd3fc; font-size: 18px; opacity: 0.85; }
.veo-job-ratio {
  position: absolute; bottom: 6px; right: 6px; font-size: 10px; color: #cbd5e1;
  background: rgba(0,0,0,0.45); padding: 2px 5px; border-radius: 6px;
}
.veo-job-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
.veo-job-title { font-weight: 600; font-size: 13px; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.veo-job-prompt { font-size: 12px; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.veo-job-bar { height: 6px; border-radius: 99px; background: #1e293b; overflow: hidden; }
.veo-job-fill { height: 100%; background: linear-gradient(90deg, #22d3ee, #38bdf8); transition: width 0.25s ease; }
.veo-job-card.xong .veo-job-fill { background: linear-gradient(90deg, #4ade80, #22c55e); }
.veo-job-card.loi .veo-job-fill { background: linear-gradient(90deg, #f87171, #ef4444); }
.veo-job-foot { display: flex; align-items: center; gap: 8px; margin-top: auto; }
.veo-job-act {
  border: 0; background: #1e293b; color: #cbd5e1; width: 28px; height: 28px; border-radius: 8px; cursor: pointer;
}
.veo-job-act:disabled { opacity: 0.35; cursor: not-allowed; }
.veo-job-act.danger:hover { background: rgba(248,113,113,0.2); color: #f87171; }
.veo-job-act:not(.danger):hover { background: #334155; }
.grow { flex: 1; }

.veo-img-grid-wrap { display: flex; flex-direction: column; gap: 8px; }
.veo-img-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.veo-img-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; max-height: 220px; overflow: auto; }
.veo-img-thumb {
  position: relative; aspect-ratio: 1; border-radius: 10px; overflow: hidden; background: #0f172a; border: 1px solid #243044;
}
.veo-img-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.veo-img-x {
  position: absolute; top: 4px; right: 4px; border: 0; background: rgba(0,0,0,0.55); color: #fff;
  width: 22px; height: 22px; border-radius: 6px; cursor: pointer; font-size: 11px;
}
.veo-img-name {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 4px 6px; font-size: 10px; color: #e2e8f0;
  background: linear-gradient(transparent, rgba(0,0,0,0.75)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.veo-slot.filled { padding: 0; overflow: hidden; }
.veo-slot-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.veo-ref-thumb {
  width: 48px; height: 48px; border-radius: 8px; overflow: hidden; position: relative; border: 1px solid #243044;
}
.veo-ref-thumb img { width: 100%; height: 100%; object-fit: cover; }
.veo-ref-thumb button {
  position: absolute; top: 2px; right: 2px; border: 0; background: rgba(0,0,0,0.6); color: #fff;
  width: 16px; height: 16px; border-radius: 4px; font-size: 10px; cursor: pointer; padding: 0;
}
.veo-project-list { display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow: auto; }
.veo-project-card {
  text-align: left; border: 1px solid #243044; background: #121826; border-radius: 10px; padding: 10px;
  color: #e2e8f0; cursor: pointer; display: grid; gap: 4px;
}
.veo-project-card.on { border-color: #38bdf8; background: rgba(56,189,248,0.08); }
.veo-project-title { font-weight: 600; font-size: 13px; }
.veo-project-meta { font-size: 11px; color: #94a3b8; }
.veo-sync-slot.filled { padding: 0; overflow: hidden; }
.veo-sync-slot.filled img { width: 100%; height: 100%; object-fit: cover; }
.veo-toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
  background: #0f172a; border: 1px solid #38bdf8; color: #e2e8f0;
  padding: 10px 16px; border-radius: 10px; z-index: 1000; box-shadow: 0 10px 30px rgba(0,0,0,0.35);
  font-size: 13px;
}
.veo-link:disabled, .veo-start:disabled { opacity: 0.4; cursor: not-allowed; }

/* === Omni (abra_edit) mode === */
.veo-omni.hero {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(139,92,246,0.28), rgba(45,212,191,0.12));
  border: 1px solid rgba(167,139,250,0.45);
  margin-bottom: 4px;
}
.veo-omni-title { font-size: 13px; font-weight: 700; color: #e9d5ff; }
.veo-omni-sub { font-size: 11px; color: #c4b5fd; opacity: 0.9; }
.veo-omni-intents { display: flex; flex-direction: column; gap: 6px; }
.veo-omni-intent {
  display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
  text-align: left; padding: 8px 10px; border-radius: 8px;
  border: 1px solid #2a3344; background: #121722; color: #c7d0de; cursor: pointer;
}
.veo-omni-intent:hover { border-color: #4c1d95; }
.veo-omni-intent.on {
  border-color: #a78bfa;
  background: rgba(139,92,246,0.16);
  box-shadow: inset 0 0 0 1px rgba(167,139,250,0.35);
}
.veo-omni-intent-label { font-size: 13px; font-weight: 700; color: #ede9fe; }
.veo-omni-intent-hint { font-size: 11px; color: #9ca3af; }

/* ===== I2V list + EndFrame + batch prompts ===== */
.veo-mode-dd.i2v-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
  position: relative;
}
.veo-mode-dd.i2v-bar .veo-mode-menu {
  left: 0;
  top: calc(100% + 4px);
  z-index: 30;
}
.veo-endframe-toggle {
  border: 1px solid #2a3344;
  background: #151b27;
  color: #9aa6ba;
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
  white-space: nowrap;
}
.veo-endframe-toggle.on {
  border-color: rgba(45,212,191,0.55);
  background: rgba(45,212,191,0.16);
  color: #2dd4bf;
  box-shadow: 0 0 0 1px rgba(45,212,191,0.2) inset;
}
.i2v-bar-acts {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6px;
}
.i2v-ico-btn {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  border: 1px solid #2a3344;
  background: #151b27;
  color: #c9d2e0;
  cursor: pointer;
  display: grid;
  place-items: center;
  font-size: 13px;
  padding: 0;
}
.i2v-ico-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.i2v-ico-btn:not(:disabled):hover { border-color: #3a4660; background: #1a2130; }
.i2v-ico-btn.wand { color: #a78bfa; }
.i2v-count-badge {
  font-size: 12px;
  font-weight: 650;
  color: #c9d2e0;
  background: #151b27;
  border: 1px solid #2a3344;
  border-radius: 999px;
  padding: 4px 10px;
  white-space: nowrap;
}
.i2v-list-wrap {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
}
.i2v-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: min(46vh, 440px);
  overflow: auto;
  padding-right: 2px;
}
.i2v-card {
  border: 1px solid #2a3344;
  background: #121826;
  border-radius: 12px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.i2v-card-top {
  display: flex;
  align-items: center;
  gap: 8px;
}
.i2v-card-name {
  flex: 1;
  font-size: 12.5px;
  font-weight: 650;
  color: #e8eef8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.i2v-card-acts { display: flex; gap: 2px; }
.i2v-act {
  border: 0;
  background: transparent;
  color: #8b97ab;
  cursor: pointer;
  width: 24px;
  height: 24px;
  border-radius: 6px;
  font-size: 12px;
}
.i2v-act:hover { background: #1a2130; color: #e8eef8; }
.i2v-row-start {
  display: grid;
  grid-template-columns: 76px 1fr;
  grid-template-rows: auto 72px;
  gap: 4px 10px;
  align-items: start;
}
.i2v-row-start .i2v-frame-label { grid-column: 1; grid-row: 1; }
.i2v-row-start .i2v-frame-spacer { grid-column: 2; grid-row: 1; }
.i2v-row-start .i2v-frame-box { grid-column: 1; grid-row: 2; }
.i2v-row-start .i2v-prompt.beside { grid-column: 2; grid-row: 2; }
.i2v-frames {
  display: grid;
  gap: 8px;
}
.i2v-frames.two { grid-template-columns: 1fr 1fr; }
.i2v-frame { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.i2v-frame-label {
  font-size: 11px;
  color: #8b97ab;
  font-weight: 600;
}
.i2v-frame-box {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 10px;
  overflow: hidden;
  background: #0c1017;
  border: 1px solid #2a3344;
  display: grid;
  place-items: center;
  color: #8b97ab;
}
.i2v-frame-box.sm {
  width: 72px;
  height: 72px;
  aspect-ratio: auto;
}
.i2v-frame-box.filled img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.i2v-frame-box.dashed {
  border: 1.5px dashed #3a4660;
  background: #0c1017;
  cursor: pointer;
  color: #8b97ab;
}
.i2v-frame-box.dashed:hover {
  border-color: #2dd4bf;
  color: #2dd4bf;
}
.i2v-frame-box.dashed .up { font-size: 16px; }
.i2v-frame-x {
  position: absolute;
  top: 4px;
  right: 4px;
  border: 0;
  background: rgba(0,0,0,0.6);
  color: #fff;
  width: 20px;
  height: 20px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 11px;
  padding: 0;
}
.i2v-prompt {
  width: 100%;
  min-height: 64px;
  resize: vertical;
  border-radius: 8px;
  border: 1px solid #2a3344;
  background: #0c1017;
  color: #e8eef8;
  padding: 8px 10px;
  font-size: 12.5px;
  font-family: inherit;
  line-height: 1.4;
  box-sizing: border-box;
}
.i2v-prompt.beside {
  min-height: 72px;
  height: 72px;
  resize: none;
}
.i2v-add-row { display: flex; gap: 6px; flex-wrap: wrap; }

.i2v-batch-modal {
  width: min(720px, 94vw);
  max-height: min(86vh, 820px);
  display: flex;
  flex-direction: column;
}
.i2v-batch-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow: auto;
}
.i2v-batch-guide {
  background: #0c1017;
  border: 1px solid #2a3344;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 12.5px;
  color: #9aa6ba;
  line-height: 1.45;
}
.i2v-batch-guide strong { color: #e8eef8; }
.i2v-batch-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.i2v-batch-count {
  font-size: 12.5px;
  font-weight: 700;
  color: #2dd4bf;
}
.i2v-batch-ta { min-height: 120px; }
.i2v-batch-preview-label {
  font-size: 12.5px;
  font-weight: 650;
  color: #c9d2e0;
}
.i2v-batch-preview {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 220px;
  overflow: auto;
  border: 1px solid #2a3344;
  border-radius: 10px;
  padding: 8px;
  background: #0c1017;
}
.i2v-batch-row {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 10px;
  align-items: center;
  padding: 6px;
  border-radius: 8px;
  background: #121826;
}
.i2v-batch-thumb {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  overflow: hidden;
  background: #0c1017;
  border: 1px solid #2a3344;
  display: grid;
  place-items: center;
}
.i2v-batch-thumb img { width: 100%; height: 100%; object-fit: cover; }
.i2v-batch-name { font-size: 12px; font-weight: 650; color: #e8eef8; }
.i2v-batch-prompt { font-size: 11.5px; color: #c9d2e0; margin-top: 2px; line-height: 1.35; }
.i2v-batch-prompt.empty { color: #6b778c; font-style: italic; }
.veo-teal-btn.dim, .veo-teal-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  filter: grayscale(0.25);
}
.veo-link {
  border: 0;
  background: transparent;
  color: #60a5fa;
  cursor: pointer;
  font-size: 12px;
  padding: 0;
}
.veo-link:hover { text-decoration: underline; }

