.shell {
  height: 100%;
  display: grid;
  grid-template-rows: 44px 1fr;
  background: var(--bg);
}

/* ——— Top horizontal nav ——— */
.top-nav {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 4px;
  padding: 0 10px 0 6px;
  background: var(--bg-deep);
  border-bottom: 1px solid var(--border-soft);
  overflow-x: auto;
}

.top-nav-left {
  display: flex;
  align-items: stretch;
  gap: 2px;
  min-width: 0;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  margin: auto 6px auto 2px;
  padding: 0;
  border: 0;
  border-radius: 8px;
  flex-shrink: 0;
  background: transparent;
  cursor: pointer;
}

.brand-play {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 7px 0 7px 12px;
  border-color: transparent transparent transparent #ff7a18;
  filter: drop-shadow(0 0 6px rgba(255, 122, 24, 0.55));
  margin-left: 2px;
}

.top-tab.tab-veo.active {
  color: #ff9a4a;
  background: rgba(255, 122, 24, 0.1);
}

.top-tab.tab-veo.active::after {
  background: #ff7a18;
}

.top-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0 10px;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 12.5px;
  white-space: nowrap;
}

.top-tab:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.03);
}

.top-tab.active {
  color: var(--accent);
  background: rgba(32, 201, 151, 0.1);
}

.top-tab.active::after {
  content: '';
  position: absolute;
  left: 8px;
  right: 8px;
  bottom: 0;
  height: 2px;
  border-radius: 2px 2px 0 0;
  background: var(--accent);
}

.badge {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.05em;
  padding: 1px 5px;
  border-radius: 3px;
  background: #334155;
  color: #cbd5e1;
  line-height: 1.35;
  text-transform: uppercase;
}

.badge.new {
  background: #0ea5e9;
  color: #ecfeff;
}

.badge.beta {
  background: #f59e0b;
  color: #1c1917;
}

.badge.v3 {
  background: #e879f9;
  color: #4a044e;
}

.badge.vip {
  background: #ec4899;
  color: #fff;
}

.top-nav-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-left: 8px;
}

.ver {
  font-size: 12px;
  color: var(--accent);
  font-weight: 600;
}

.body {
  min-height: 0;
  height: 100%;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr;
}

.body:has(.settings-side) {
  grid-template-columns: 200px 1fr;
}

/* ——— Settings sidebar ——— */
.settings-side {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 10px;
  background: var(--bg-deep);
  border-right: 1px solid var(--border-soft);
  overflow: auto;
}

.side-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  text-align: left;
  font-size: 13px;
}

.side-item:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.04);
}

.side-item.active {
  color: #fff;
  background: var(--accent);
  border-color: transparent;
  font-weight: 600;
}

.side-ico {
  width: 18px;
  text-align: center;
  font-size: 13px;
  opacity: 0.9;
}

.settings-main {
  min-width: 0;
  min-height: 0;
  overflow: auto;
  padding: 18px 22px;
  background:
    radial-gradient(800px 360px at 90% -10%, rgba(32, 201, 151, 0.08), transparent 55%),
    var(--bg);
}

.settings-panel {
  display: grid;
  gap: 14px;
  max-width: 920px;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.panel-head h3,
.panel-card h3 {
  margin: 0 0 12px;
  font-size: 16px;
  font-weight: 650;
  display: flex;
  align-items: center;
  gap: 8px;
}

.panel-head h3 {
  margin: 0;
}

.panel-card h4 {
  margin: 0 0 8px;
  font-size: 14px;
}

.panel-card .ico,
.panel-head .ico {
  font-size: 15px;
}

.panel-card {
  border: 1px solid var(--border-soft);
  background: var(--bg-panel);
  border-radius: 12px;
  padding: 16px 18px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
}

.gateway-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border-radius: 999px;
  border: 1px solid var(--accent-border);
  color: var(--accent);
  font-size: 12px;
  background: var(--accent-dim);
}

.gateway-pill.live .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
  display: inline-block;
  box-shadow: 0 0 8px rgba(52, 211, 153, 0.55);
}



/* ——— Settings polish (SuperVeo-style layout) ——— */
.user-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.user-email {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  font-size: 14px;
}
.user-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(45, 212, 191, 0.15);
  border: 1px solid rgba(45, 212, 191, 0.35);
  font-size: 13px;
}
.user-verified {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--success);
  font-size: 13px;
  font-weight: 600;
}
.row-ico { margin-right: 4px; opacity: 0.85; }

.api-tabs-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
.browser-row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.browser-btn {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-deep);
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}
.browser-btn.on {
  border-color: var(--accent);
  background: var(--accent);
  color: #04120f;
}

.cookie-box {
  border: 1px solid var(--border-soft);
  border-radius: 10px;
  padding: 12px;
  background: var(--bg-deep);
  margin-bottom: 12px;
}
.cookie-box-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  font-size: 13px;
}
.cookie-input-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.cookie-input-row .input.full {
  margin-top: 0;
  flex: 1;
}

.block-label {
  margin: 0 0 8px;
  font-size: 12px;
  color: var(--muted);
  font-weight: 600;
  letter-spacing: 0.02em;
}
.section-tag {
  margin: 14px 0 8px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.acct-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}
.acct-list-head h4 { margin: 0; }
.acct-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 6px 0 4px;
}
.pill {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 650;
  border: 1px solid var(--border);
  color: var(--muted);
}
.pill.ok {
  color: #6ee7b7;
  border-color: rgba(52, 211, 153, 0.45);
  background: rgba(52, 211, 153, 0.12);
}
.pill.ready {
  color: #93c5fd;
  border-color: rgba(96, 165, 250, 0.4);
  background: rgba(59, 130, 246, 0.12);
}
.pill.plan {
  color: #fcd34d;
  border-color: rgba(251, 191, 36, 0.35);
  background: rgba(251, 191, 36, 0.08);
}
.pill.gateway {
  color: #c4b5fd;
  border-color: rgba(167, 139, 250, 0.45);
  background: rgba(139, 92, 246, 0.14);
}
.acct-card.gateway {
  border-color: rgba(167, 139, 250, 0.3);
}
.btn.danger-ghost {
  color: #fca5a5;
  border-color: rgba(248, 113, 113, 0.35);
  background: transparent;
}
.btn.sm { padding: 6px 10px; font-size: 12px; }

.info-callout {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(37, 99, 235, 0.12);
  border: 1px solid rgba(96, 165, 250, 0.28);
  color: #bfdbfe;
  font-size: 13px;
}
.info-callout p { margin: 4px 0 0; color: #93c5fd; font-size: 12px; }

.accent-title { color: var(--accent); }
.ok-dot { color: #34d399; margin-right: 6px; font-size: 10px; }
.ok-flash { color: #6ee7b7 !important; margin-top: 8px; }

.check {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text);
  cursor: pointer;
}
.check input {
  accent-color: var(--accent);
  width: 15px;
  height: 15px;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-soft);
  font-size: 13px;
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-row .label {
  color: var(--muted);
}

.info-row .value {
  color: var(--text);
  font-weight: 500;
}

.info-row .value.accent {
  color: var(--accent);
}

.info-row .value.ok {
  color: var(--success);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.info-row .value.warn-text {
  color: var(--danger);
  font-weight: 650;
}

.check-box {
  display: inline-flex;
  width: 18px;
  height: 18px;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  background: rgba(52, 211, 153, 0.2);
  color: var(--success);
  font-size: 11px;
}

.blue-dot {
  margin-right: 4px;
}

.warn-banner {
  margin: 12px 0 14px;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid rgba(251, 191, 36, 0.45);
  background: rgba(251, 191, 36, 0.08);
  color: #fcd34d;
  font-size: 13px;
}

.note-banner {
  margin-top: 14px;
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(56, 120, 200, 0.12);
  border: 1px solid rgba(96, 165, 250, 0.25);
  color: #93c5fd;
  font-size: 13px;
}

.setting-block {
  padding: 12px 0;
  border-bottom: 1px solid var(--border-soft);
}

.setting-block:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.prefix-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 8px 0 4px;
}

.seg {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.seg-btn {
  border: 1px solid var(--border);
  background: var(--bg-deep);
  color: var(--muted);
  border-radius: 999px;
  padding: 7px 14px;
  font-size: 13px;
}

.seg-btn.on {
  color: #fff;
  border-color: var(--accent);
  background: var(--accent);
  font-weight: 600;
}

.input.full,
.btn.full {
  width: 100%;
  margin-top: 8px;
}

.acct-list {
  margin-top: 14px;
  display: grid;
  gap: 8px;
}

.acct-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  padding: 12px;
  border-radius: 10px;
  border: 1px solid var(--border-soft);
  background: var(--bg-card);
}

.acct-mail {
  font-weight: 600;
  font-size: 13px;
}

.acct-meta {
  font-size: 11px;
  color: var(--muted);
  margin-top: 2px;
}

.acct-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn.teal {
  border-color: var(--accent-border);
  background: var(--accent-dim);
  color: var(--accent);
}

.crop-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin: 8px 0 14px;
}

.crop-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.crop-grid.dim {
  opacity: 0.45;
  pointer-events: none;
}

.crop-card {
  text-align: left;
  border: 1px solid var(--border);
  background: var(--bg-deep);
  border-radius: 12px;
  padding: 14px;
  color: var(--text);
  display: grid;
  gap: 8px;
}

.crop-card.selected {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
  background: rgba(32, 201, 151, 0.06);
}

.crop-card ul {
  margin: 0;
  padding-left: 0;
  list-style: none;
  font-size: 12px;
  color: var(--muted);
  display: grid;
  gap: 4px;
}

.crop-card li.ok::before {
  content: '✓ ';
  color: var(--success);
}

.crop-card li.warn::before {
  content: '⚠ ';
  color: var(--warn);
}

.crop-preview {
  height: 72px;
  border-radius: 8px;
  background: #0a0e16;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border-soft);
}

.crop-preview.pad {
  padding: 0 18%;
}

.crop-preview .img-box {
  background: #3d4a63;
  color: #c8d0e2;
  font-size: 11px;
  padding: 10px 18px;
  border-radius: 4px;
}

.crop-preview.crop .img-box.fill {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}

.adv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 0;
}

.toggle {
  width: 44px;
  height: 24px;
  border-radius: 999px;
  border: none;
  background: #334155;
  padding: 2px;
  flex-shrink: 0;
  transition: background 0.15s;
}

.toggle.on {
  background: var(--accent);
}

.toggle-knob {
  display: block;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.15s;
}

.toggle.on .toggle-knob {
  transform: translateX(20px);
}

.placeholder {
  padding: 48px 28px;
  color: var(--muted);
}

.placeholder h2 {
  margin: 0 0 8px;
  color: var(--text);
}

/* ——— Muse workspace ——— */
.muse-wrap {
  display: grid;
  grid-template-rows: 52px 1fr auto;
  min-height: 0;
  min-width: 0;
  background:
    radial-gradient(900px 420px at 80% -20%, rgba(32, 201, 151, 0.1), transparent 60%),
    radial-gradient(700px 360px at 10% 110%, rgba(99, 102, 241, 0.07), transparent 55%),
    var(--bg);
}

.muse-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 20px;
  border-bottom: 1px solid var(--border-soft);
  background: rgba(12, 18, 28, 0.72);
  backdrop-filter: blur(12px);
}

.top-left {
  display: flex;
  align-items: baseline;
  gap: 10px;
  min-width: 0;
}

.top-left h1 {
  margin: 0;
  font-size: 16px;
  font-weight: 650;
}

.crumb {
  font-size: 12px;
  color: var(--muted);
}

.top-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 11px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  color: var(--muted);
  font-size: 12px;
}

.pill.update {
  color: #99f6e4;
  border-color: var(--accent-border);
  background: var(--accent-dim);
  cursor: pointer;
}

.pill.update:hover {
  border-color: var(--accent);
}

.pill.status .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--warn);
  display: inline-block;
}

.pill.online .dot {
  background: var(--success);
  box-shadow: 0 0 8px rgba(52, 211, 153, 0.6);
}

.muse-content {
  min-height: 0;
  overflow: auto;
  padding: 16px 20px;
  display: grid;
  gap: 14px;
  grid-template-rows: auto 1fr;
}

.card {
  border: 1px solid var(--border-soft);
  background: rgba(21, 29, 44, 0.95);
  border-radius: 14px;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.22);
}

.controls {
  padding: 14px;
  display: grid;
  gap: 12px;
}

.mode-tabs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.mode-tab {
  border: 1px solid var(--border);
  background: var(--bg-deep);
  color: var(--muted);
  border-radius: 999px;
  padding: 8px 14px;
  font-size: 13px;
}

.mode-tab:hover {
  color: var(--text);
  border-color: #3d4863;
}

.mode-tab.on {
  color: #042f2e;
  border-color: transparent;
  background: var(--accent);
  font-weight: 650;
  box-shadow: 0 6px 18px rgba(32, 201, 151, 0.28);
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 16px;
}

.tool-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tool-group > label:not(.check) {
  font-size: 12px;
  color: var(--muted);
}

.tool-group.tone .select {
  min-width: 170px;
}

.select,
.input {
  background: var(--bg-deep);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 12px;
  color: var(--text);
}

.select:focus,
.input:focus,
.prompt:focus {
  outline: 1px solid rgba(32, 201, 151, 0.55);
  border-color: rgba(32, 201, 151, 0.45);
}

.select:disabled,
.input:disabled {
  opacity: 0.45;
}

.input.grow {
  flex: 1;
  min-width: 160px;
}

.check {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--muted);
  user-select: none;
}

.check input {
  accent-color: var(--accent);
}

.prompt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.muted {
  color: var(--muted);
  font-size: 13px;
}

.muted.sm {
  font-size: 12px;
  margin: 4px 0 0;
}

.prompt {
  width: 100%;
  min-height: 100px;
  resize: vertical;
  background: var(--bg-deep);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  line-height: 1.5;
}

.prompt.short {
  min-height: 72px;
  margin-top: 8px;
}

.path-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.table-card {
  display: grid;
  grid-template-rows: auto 1fr;
  min-height: 220px;
  overflow: hidden;
}

.table-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--border-soft);
}

.table-head h2 {
  margin: 0;
  font-size: 14px;
  font-weight: 650;
}

.table-meta {
  display: flex;
  gap: 8px;
  font-size: 12px;
  color: var(--muted);
}

.table-scroll {
  overflow: auto;
  min-height: 0;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

th,
td {
  padding: 11px 14px;
  border-bottom: 1px solid var(--border-soft);
  text-align: left;
  white-space: nowrap;
}

th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #141c2a;
  color: var(--muted);
  font-weight: 600;
  font-size: 12px;
}

tr.row-active {
