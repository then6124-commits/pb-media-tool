      </div>

      <div className="panel-card">
        <h4>Cấu hình Proxy</h4>
        <div className="seg">
          <button
            type="button"
            className={`seg-btn ${proxyTab === 'list' ? 'on' : ''}`}
            onClick={() => setProxyTab('list')}
          >
            📋 Proxy List
          </button>
          <button
            type="button"
            className={`seg-btn ${proxyTab === 'rotate' ? 'on' : ''}`}
            onClick={() => setProxyTab('rotate')}
          >
            ↻ Proxy Xoay
          </button>
