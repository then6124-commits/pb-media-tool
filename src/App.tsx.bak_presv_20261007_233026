function SettingsApi() {
  const [apiTab, setApiTab] = usePref<'cookie' | 'account'>('pb.settings.api.tab', 'cookie')
  const [browsers, setBrowsers] = usePref<number[]>('pb.settings.api.browsers', [1, 2, 3, 4])
  const [browser, setBrowser] = usePref<number>('pb.settings.api.browser', 1)
  const [useOnlyLabs, setUseOnlyLabs] = usePref('pb.settings.api.useOnlyLabs', false)
  const [cookies, setCookies] = usePref<CookieSlot[]>('pb.settings.api.cookies', [])
  const [draftToken, setDraftToken] = useState('')
  const [showToken, setShowToken] = usePref('pb.settings.api.showToken', false)
  const [accounts, setAccounts] = usePref<MockAccount[]>('pb.settings.api.accounts', DEFAULT_ACCOUNTS)
  const [accountPaste, setAccountPaste] = usePref('pb.settings.api.accountPaste', '')
  const [newMail, setNewMail] = useState('')
  const [newPass, setNewPass] = useState('')
  const [newKind, setNewKind] = useState<'tool' | 'gateway'>('tool')
  const [flash, setFlash] = useState('')
  const [flashFail, setFlashFail] = useState(false)
  const [loginBusy, setLoginBusy] = useState(false)
  const [testingId, setTestingId] = useState<string | null>(null)

  const showFlash = (m: string, fail = false) => {
    setFlash(m)
    setFlashFail(fail)
    window.setTimeout(() => {
      setFlash('')
      setFlashFail(false)
    }, 2600)
  }

  const activeCookie = cookies.find((c) => c.browser === browser)
  const gateway = accounts.find((a) => a.kind === 'gateway' && a.active) || accounts.find((a) => a.kind === 'gateway')

  const ensureBrowserSelected = (list: number[], current: number) => {
    if (list.includes(current)) return current
    return list[0] ?? 1
  }

  const addBrowser = () => {
    const next = (browsers.length ? Math.max(...browsers) : 0) + 1
    const list = [...browsers, next]
    setBrowsers(list)
    setBrowser(next)
    showFlash(`Đã thêm Browser ${next}`)
  }

  const removeBrowser = (n: number) => {
    if (browsers.length <= 1) {
      showFlash('Cần giữ ít nhất 1 browser')
      return
    }
    const list = browsers.filter((b) => b !== n)
    setBrowsers(list)
    setCookies((prev) => prev.filter((c) => c.browser !== n))
    setBrowser(ensureBrowserSelected(list, browser === n ? list[0] : browser))
    showFlash(`Đã xoá Browser ${n}`)
  }

  const saveCookie = () => {
    const token = draftToken.trim() || activeCookie?.token || ''
    if (!token) {
      showFlash('Nhập token/cookie mock trước')
      return
    }
    setCookies((prev) => {
      const rest = prev.filter((c) => c.browser !== browser)
      return [...rest, { browser, token, label: `Browser ${browser}` }]
    })
    setDraftToken('')
    showFlash(`Đã lưu cookie mock cho Browser ${browser} (localStorage)`)
  }

  const clearCookie = () => {
    setCookies((prev) => prev.filter((c) => c.browser !== browser))
    setDraftToken('')
    showFlash(`Đã xoá cookie Browser ${browser}`)
  }

  const mockJudgeToken = (token: string, mailHint = '') => {
    const raw = (token || '').trim()
    const hint = (mailHint || '').toLowerCase()
    if (!raw) return { ok: false, msg: 'FAIL — chưa có cookie/token mock' }
    if (raw.length < 8) return { ok: false, msg: 'FAIL — token quá ngắn (<8)' }
    if (/fail|expired|invalid|401|hết hạn/i.test(raw) || /fail|expired|invalid/.test(hint)) {
      return { ok: false, msg: 'FAIL — cookie/mock bị từ chối (HTTP 401 giả lập)' }
    }
    return { ok: true, msg: `PASS — phiên mock OK (${raw.length} ký tự)` }
  }

  const testCookie = () => {
    const token = (draftToken.trim() || activeCookie?.token || '').trim()
    setTestingId(`cookie-${browser}`)
    window.setTimeout(() => {
      const r = mockJudgeToken(token)
      setCookies((prev) => {
        const rest = prev.filter((c) => c.browser !== browser)
        if (!token && !activeCookie) return prev
        const base = activeCookie || { browser, token, label: `Browser ${browser}` }
        return [...rest, { ...base, token: token || base.token, lastTest: r.msg, testOk: r.ok }]
      })
      setTestingId(null)
      showFlash(r.msg, !r.ok)
    }, 550)
  }

  const addSingleMail = () => {
    const mail = newMail.trim()
    if (!mail || !mail.includes('@')) {
      showFlash('Nhập email hợp lệ (có @)', true)
      return
    }
    const pass = newPass.trim()
    const acc: MockAccount = {
      id: uid('acc'),
      mail,
      status: 'Sẵn sàng',
      plan: pass ? 'PRO (mock)' : 'FREE (mock)',
      kind: newKind,
      session: `mock_${Math.random().toString(36).slice(2, 10)}`,
      browser,
      active: false,
      lastTest: 'Chưa kiểm tra',
      testOk: null,
    }
    setAccounts((prev) => [...prev, acc])
    setNewMail('')
    setNewPass('')
    showFlash(`Đã thêm mail ${mail} (mock)`)
  }

  const testAccount = (id: string) => {
    const acc = accounts.find((a) => a.id === id)
    if (!acc) return
    setTestingId(id)
    window.setTimeout(() => {
      const cookie = cookies.find((c) => c.browser === acc.browser)
      const token = cookie?.token || acc.session || ''
      let r = mockJudgeToken(token, acc.mail)
      if (!cookie?.token && acc.session) {
        // account có session mock nhưng chưa gắn cookie browser → vẫn PASS nhẹ
        if (/fail|expired|invalid/.test(acc.mail.toLowerCase())) {
          r = { ok: false, msg: 'FAIL — email mock đánh dấu lỗi' }
        } else {
          r = { ok: true, msg: 'PASS — account mock có session (chưa gắn cookie browser)' }
        }
      }
      setAccounts((prev) =>
        prev.map((a) =>
          a.id === id
            ? {
                ...a,
                lastTest: r.msg,
                testOk: r.ok,
                status: r.ok ? (a.active && a.kind === 'tool' ? 'Đang kích hoạt' : 'Sẵn sàng') : 'Lỗi phiên',
                session: r.ok ? `mock_${Math.random().toString(36).slice(2, 10)}` : a.session,
              }
            : a,
        ),
      )
      setTestingId(null)
      showFlash(`${acc.mail}: ${r.msg}`, !r.ok)
    }, 600)
  }

  const startAutoLogin = () => {
    const lines = accountPaste
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter(Boolean)
    if (!lines.length) {
      showFlash('Dán email|password (mỗi dòng 1 account)')
      return
    }
    setLoginBusy(true)
    window.setTimeout(() => {
      const added: MockAccount[] = []
      for (const line of lines) {
        const [mail, pass] = line.split('|').map((s) => s.trim())
        if (!mail) continue
        added.push({
          id: uid('acc'),
          mail,
          status: 'Sẵn sàng',
          plan: pass ? 'PRO (mock)' : 'FREE (mock)',
          kind: mail.toLowerCase().includes('gateway') ? 'gateway' : 'tool',
          session: `mock_${Math.random().toString(36).slice(2, 10)}`,
          browser,
          active: false,
          lastTest: 'Chưa kiểm tra',
          testOk: null,
        })
      }
      if (!added.length) {
        setLoginBusy(false)
        showFlash('Không parse được account')
        return
      }
      setAccounts((prev) => [...prev, ...added])
      setAccountPaste('')
      setLoginBusy(false)
      showFlash(`Đã thêm ${added.length} account (mock login)`)
    }, 700)
  }

  const activateAccount = (id: string) => {
    setAccounts((prev) =>
      prev.map((a) => {
        if (a.id === id) {
          return { ...a, active: true, status: a.kind === 'gateway' ? 'Sẵn sàng' : 'Đang kích hoạt', browser }
        }
        if (a.kind === prev.find((x) => x.id === id)?.kind) {
          return { ...a, active: false, status: a.kind === 'tool' && a.status === 'Đang kích hoạt' ? 'Sẵn sàng' : a.status }
        }
        return a
      }),
    )
    showFlash('Đã kích hoạt account (mock)')
  }

  const deleteAccount = (id: string) => {
    setAccounts((prev) => prev.filter((a) => a.id !== id))
    showFlash('Đã xoá account')
  }

  const clearAllAccounts = () => {
    if (!window.confirm('Xoá tất cả tài khoản mock?')) return
    setAccounts([])
    showFlash('Đã xoá tất cả account')
  }

  const refreshAccounts = () => {
    setAccounts((prev) =>
      prev.map((a) => ({
        ...a,
        session: `mock_${Math.random().toString(36).slice(2, 10)}`,
        status: a.active && a.kind === 'tool' ? 'Đang kích hoạt' : 'Sẵn sàng',
      })),
    )
    showFlash('Đã làm mới session (mock)')
  }

  return (
    <div className="settings-panel">
      <div className="panel-head">
        <h3>
          <span className="ico">⚙️</span> Cấu hình API
        </h3>
        <span className="gateway-pill live">
          <i className="dot" /> Gateway: {gateway?.mail || '— chưa chọn —'}
        </span>
      </div>

      <div className="panel-card">
        <div className="api-tabs-row">
          <div className="seg">
            <button
              type="button"
              className={`seg-btn ${apiTab === 'cookie' ? 'on' : ''}`}
              onClick={() => setApiTab('cookie')}
            >
              🍪 Cookie (mock)
            </button>
            <button
              type="button"
              className={`seg-btn ${apiTab === 'account' ? 'on' : ''}`}
              onClick={() => setApiTab('account')}
            >
              👤 Account
            </button>
          </div>
          <div className="browser-row">
            <span className="muted sm">Browsers:</span>
            {browsers.map((n) => (
              <button
                key={n}
                type="button"
                className={`browser-btn ${browser === n ? 'on' : ''}`}
                onClick={() => {
                  setBrowser(n)
                  setDraftToken('')
                }}
                title={`Chọn Browser ${n}`}
              >
                {n}
              </button>
            ))}
            <button type="button" className="btn sm teal" onClick={addBrowser} title="Thêm browser">
              +
            </button>
            <button
              type="button"
              className="btn sm danger-ghost"
              onClick={() => removeBrowser(browser)}
              title="Xoá browser đang chọn"
            >
              −
            </button>
          </div>
        </div>

        {apiTab === 'cookie' ? (
          <>
            <div className="cookie-box">
              <div className="cookie-box-head">
                <span>Session token / Cookie (mock) · Browser {browser}</span>
                <span className="muted sm">
                  {activeCookie?.token ? '✓ Đã lưu local' : '⚠ Chưa có'}
                </span>
              </div>
              <div className="cookie-input-row">
                <input
                  className="input full"
                  type={showToken ? 'text' : 'password'}
                  placeholder="Dán cookie/token mock (chỉ lưu localStorage — không đọc cookie trình duyệt thật)…"
                  value={draftToken || (showToken ? activeCookie?.token || '' : activeCookie?.token ? '••••••••••••' : '')}
                  onChange={(e) => {
